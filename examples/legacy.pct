*** LEGACY macro table decks - PCT, PPT, FCT, DCT and RCT in one member.
***
*** GENERATED by tools/make_examples.py. Do not hand-edit: HLASM continues a statement
*** only when column 72 - column 72 EXACTLY - is non-blank, and the first draft of this
*** file had its continuation mark in column 74, which continues nothing and loses every
*** operand on the next line without a word.
***
*** WRITTEN FROM IBM'S MACRO DOCUMENTATION, not from a real estate. There is no public
*** corpus of DFHPCT/DFHFCT decks - they survive only inside private estates - so unlike
*** the CSD path, which has AWS CardDemo behind it, this proves only that the code does
*** what it was built to do.
***
*** Note what is NOT here: a GROUP, and a LIST. A macro table has neither. What makes it
*** live is the SIT naming its suffix - PCT=L1 loads DFHPCTL1 - so these resources cannot
*** take part in the GRPLIST closure at all.
DFHPCTL1 DFHPCT TYPE=INITIAL,SUFFIX=L1
         DFHPCT TYPE=ENTRY,TRANSID=LGMN,PROGRAM=LGMENU,TWASIZE=100,    X
               TASKREQ=PF1,RSLKEY=1
         DFHPCT TYPE=ENTRY,TRANSID=LGOR,PROGRAM=LGORDER,TWASIZE=512
         DFHPCT TYPE=FINAL
         END
DFHPPTL1 DFHPPT TYPE=INITIAL,SUFFIX=L1
         DFHPPT TYPE=ENTRY,PROGRAM=LGMENU,PGMLANG=COBOL,RES=NO
         DFHPPT TYPE=ENTRY,PROGRAM=LGORDER,PGMLANG=COBOL,RES=NO
         DFHPPT TYPE=ENTRY,MAPSET=LGMAP,RES=YES
         DFHPPT TYPE=FINAL
         END
DFHFCTL1 DFHFCT TYPE=INITIAL,SUFFIX=L1
         DFHFCT TYPE=DATASET,DATASET=CUSTMAS,ACCMETH=(VSAM,KSDS),      X
               SERVREQ=(GET,PUT,UPDATE,BROWSE),LSRPOOL=1
         DFHFCT TYPE=DATASET,DATASET=RATETAB,ACCMETH=(VSAM,KSDS),      X
               SERVREQ=(GET,BROWSE),LSRPOOL=1
         DFHFCT TYPE=FINAL
         END
DFHDCTL1 DFHDCT TYPE=INITIAL,SUFFIX=L1
         DFHDCT TYPE=INTRA,DESTID=ORDQ,TRANSID=LGOR,TRIGLEV=1,         X
               RSL=PUBLIC
         DFHDCT TYPE=EXTRA,DESTID=RPTQ,DSCNAME=LGRPT
         DFHDCT TYPE=FINAL
         END
DFHRCTL1 DSNCRCT TYPE=INIT,SUFFIX=L1
         DSNCRCT TYPE=ENTRY,TXID=LGOR,PLAN=LGPLAN,THRDA=2,THRDM=4
         DSNCRCT TYPE=FINAL
         END
