*** LGMAP - a BMS mapset. GENERATED by tools/make_examples.py, for the column reason
*** above. The symbolic map DFHMSD TYPE=DSECT generates from this is what a COBOL program
*** copies: field CUSTNO becomes CUSTNOL, CUSTNOF, CUSTNOA, CUSTNOI and CUSTNOO.
LGMAP    DFHMSD TYPE=MAP,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,           X
               TIOAPFX=YES,CTRL=(FREEKB,FRSET)
LGMENU   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TITLE    DFHMDF POS=(1,1),LENGTH=20,ATTRB=(PROT,BRT),                  X
               INITIAL='CUSTOMER ORDER ENTRY'
CUSTNO   DFHMDF POS=(3,1),LENGTH=8,ATTRB=(UNPROT,IC),PICIN='X(8)',     X
               PICOUT='X(8)'
CUSTNM   DFHMDF POS=(4,1),LENGTH=30,ATTRB=(PROT,NORM)
ORDQTY   DFHMDF POS=(5,1),LENGTH=5,ATTRB=(UNPROT,NUM),PICIN='9(5)',    X
               PICOUT='ZZZZ9'
MSGOUT   DFHMDF POS=(23,1),LENGTH=79,ATTRB=(PROT,BRT)
         DFHMSD TYPE=FINAL
         END
