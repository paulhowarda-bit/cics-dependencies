*** APPREGN - a DFHCSDUP deck written for this repository.
***
*** It exists to exercise the parser and to give the byte-stability ratchet something
*** stable to hash. It is NOT the validation: that is the public corpus in corpus/,
*** which is real. An example written here can only prove the tool does what it was
*** built to do.
***
*** Every construct below is here because something in the code depends on it.
 DEFINE TRANSACTION(APMN) GROUP(APPG)
 DESCRIPTION(MAIN MENU)
        PROGRAM(APPMENU) PROFILE(DFHCICST) TRANCLASS(DFHTCL00)
        TWASIZE(0) TASKDATALOC(ANY) STATUS(ENABLED)
 DEFINE TRANSACTION(APOR) GROUP(APPG)
        PROGRAM(APPORDR) TWASIZE(512) STATUS(ENABLED)
 DEFINE TRANSACTION(APRM) GROUP(APPG)
 DESCRIPTION(RUNS IN THE BACK-END REGION)
        REMOTESYSTEM(CICSBK1) REMOTENAME(BKRM) STATUS(ENABLED)
 DEFINE PROGRAM(APPMENU) GROUP(APPG)
        LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER) STATUS(ENABLED)
 DEFINE PROGRAM(APPORDR) GROUP(APPG)
        LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER) STATUS(ENABLED)
 DEFINE PROGRAM(APPBATCH) GROUP(APPG)
        LANGUAGE(COBOL) STATUS(ENABLED) TRANSID(APOR)
 DEFINE MAPSET(APPMAP) GROUP(APPG)
        RESIDENT(NO) USAGE(NORMAL) STATUS(ENABLED)
 DEFINE FILE(CUSTMAS) GROUP(APPG)
 DESCRIPTION(CUSTOMER MASTER - UPDATED ONLINE)
        DSNAME(PROD.CUSTOMER.MASTER) LSRPOOLNUM(1)
        READ(YES) BROWSE(YES) UPDATE(YES) ADD(YES) DELETE(YES)
        JOURNAL(NO) STATUS(ENABLED) RECORDFORMAT(V)
 DEFINE FILE(RATETAB) GROUP(APPG)
 DESCRIPTION(READ ONLY - THE IO ON THIS ROW MUST SAY READ)
        DSNAME(PROD.RATE.TABLE) LSRPOOLNUM(1)
        READ(YES) BROWSE(YES) UPDATE(NO) ADD(NO) DELETE(NO)
        JOURNAL(NO) REMOTESYSTEM(NONE) STATUS(ENABLED)
 DEFINE TDQUEUE(ORDQ) GROUP(APPG)
 DESCRIPTION(A WRITE HERE STARTS APOR - THE EDGE PEOPLE MISS)
        TYPE(INTRA) TRANSID(APOR) TRIGGERLEVEL(1)
        RECOVSTATUS(LOGICAL) ATIFACILITY(FILE)
 DEFINE TDQUEUE(RPTQ) GROUP(APPG)
        TYPE(EXTRA) DDNAME(APPRPT) TYPEFILE(OUTPUT) RECORDSIZE(133)
 DEFINE TSMODEL(APPWRK) GROUP(APPG)
        PREFIX(APPWRK) LOCATION(AUXILIARY) RECOVERY(YES)
 DEFINE LIBRARY(APPLIB) GROUP(APPG)
        RANKING(50) CRITICAL(NO) STATUS(ENABLED)
        DSNAME01(PROD.APP.LOADLIB) DSNAME02(PROD.COMMON.LOADLIB)
 DEFINE TERMINAL(TRM1) GROUP(APPG)
        TYPETERM(DFHLU2) NETNAME(NETTRM1) TRANSACTION(APMN)
 DEFINE URIMAP(APPWEB) GROUP(APPG)
        USAGE(SERVER) SCHEME(HTTP) PATH(/app/order)
        HOST(*) TRANSACTION(APOR) PROGRAM(APPORDR) STATUS(ENABLED)
 ADD GROUP(APPG) LIST(APPLIST)
